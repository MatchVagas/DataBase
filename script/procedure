DELIMITER $$

CREATE PROCEDURE sp_insert_candidato(
    IN  p_id INT,
    IN  p_cpf VARCHAR(20),
    IN  p_endereco_id INT,
    IN  p_objetivo_profissional TEXT,
    IN  p_pretensao_salarial DECIMAL(10,2),
    IN  p_disponibilidade VARCHAR(50),
    IN  p_usuario_id INT,
    OUT p_new_id INT
)
BEGIN
    DECLARE v_count INT DEFAULT 0;

    START TRANSACTION;

    -- Verifica duplicidade de CPF
    SELECT COUNT(*) INTO v_count
    FROM candidatos
    WHERE cpf = p_cpf;

    IF v_count > 0 THEN
        ROLLBACK;
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'CPF ja existe';
    ELSE
        IF p_id IS NULL THEN
            INSERT INTO candidatos (cpf, endereco_id, objetivo_profissional, pretensao_salarial, disponibilidade, usuario_id)
            VALUES (p_cpf, p_endereco_id, p_objetivo_profissional, p_pretensao_salarial, p_disponibilidade, p_usuario_id);
            SET p_new_id = LAST_INSERT_ID();
        ELSE
            INSERT INTO candidatos (id, cpf, endereco_id, objetivo_profissional, pretensao_salarial, disponibilidade, usuario_id)
            VALUES (p_id, p_cpf, p_endereco_id, p_objetivo_profissional, p_pretensao_salarial, p_disponibilidade, p_usuario_id);
            SET p_new_id = p_id;
        END IF;

        COMMIT;
    END IF;
END$$

CREATE PROCEDURE sp_upsert_candidato(
    IN  p_id INT,
    IN  p_cpf VARCHAR(20),
    IN  p_endereco_id INT,
    IN  p_objetivo_profissional TEXT,
    IN  p_pretensao_salarial DECIMAL(10,2),
    IN  p_disponibilidade VARCHAR(50),
    IN  p_usuario_id INT,
    OUT p_new_id INT
)
BEGIN
    DECLARE v_existing_id INT DEFAULT NULL;
    DECLARE v_count_id INT DEFAULT 0;

    START TRANSACTION;
    SELECT id INTO v_existing_id
    FROM candidatos
    WHERE cpf = p_cpf
    LIMIT 1;

    IF v_existing_id IS NOT NULL THEN
        -- Atualiza o registro existente
        UPDATE candidatos
        SET
            cpf = p_cpf,
            endereco_id = p_endereco_id,
            objetivo_profissional = p_objetivo_profissional,
            pretensao_salarial = p_pretensao_salarial,
            disponibilidade = p_disponibilidade,
            usuario_id = p_usuario_id
        WHERE id = v_existing_id;

        SET p_new_id = v_existing_id;
        COMMIT;
    ELSE
        IF p_id IS NOT NULL THEN
            SELECT COUNT(*) INTO v_count_id FROM candidatos WHERE id = p_id;
            IF v_count_id > 0 THEN
                ROLLBACK;
                SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'ID informado ja existe e CPF nao corresponde a registro existente';
            END IF;
        END IF;

        -- Insere novo registro
        IF p_id IS NULL THEN
            INSERT INTO candidatos (cpf, endereco_id, objetivo_profissional, pretensao_salarial, disponibilidade, usuario_id)
            VALUES (p_cpf, p_endereco_id, p_objetivo_profissional, p_pretensao_salarial, p_disponibilidade, p_usuario_id);
            SET p_new_id = LAST_INSERT_ID();
        ELSE
            INSERT INTO candidatos (id, cpf, endereco_id, objetivo_profissional, pretensao_salarial, disponibilidade, usuario_id)
            VALUES (p_id, p_cpf, p_endereco_id, p_objetivo_profissional, p_pretensao_salarial, p_disponibilidade, p_usuario_id);
            SET p_new_id = p_id;
        END IF;

        COMMIT;
    END IF;
    INSERT INTO logs_eventos (usuario_id, tabela_nome, registro_id, acao,dados_novos)
    VALUES (@usuario_logado, 'candidatos', p_id, 'UPDATE', v_dados_novos);
END$$

DELIMITER ;

DELIMITER $$

CREATE PROCEDURE sp_upsert_formacao(
    IN  p_candidato_id INT,
    IN  p_instituicao VARCHAR(255),
    IN  p_curso VARCHAR(255),
    IN  p_nivel TINYINT,
    IN  p_situacao TINYINT,
    IN  p_data_inicio DATE,
    IN  p_data_conclusao DATE,
    OUT p_action VARCHAR(10),
    OUT p_affected_rows INT
)
BEGIN
    DECLARE v_exists INT DEFAULT 0;

    START TRANSACTION;

    SELECT COUNT(*) INTO v_exists
    FROM formacoes
    WHERE candidato_id = p_candidato_id
      AND instituicao = p_instituicao
      AND curso = p_curso;

    IF v_exists > 0 THEN
        -- Atualiza registro existente
        UPDATE formacoes
        SET
            nivel = p_nivel,
            situacao = p_situacao,
            data_inicio = p_data_inicio,
            data_conclusao = p_data_conclusao
        WHERE candidato_id = p_candidato_id
          AND instituicao = p_instituicao
          AND curso = p_curso;

        SET p_action = 'UPDATED';
        SET p_affected_rows = ROW_COUNT();
        COMMIT;
    ELSE
        -- Insere novo registro
        INSERT INTO formacoes (
            candidato_id,
            instituicao,
            curso,
            nivel,
            situacao,
            data_inicio,
            data_conclusao
        ) VALUES (
            p_candidato_id,
            p_instituicao,
            p_curso,
            p_nivel,
            p_situacao,
            p_data_inicio,
            p_data_conclusao
        );

        SET p_action = 'INSERTED';
        SET p_affected_rows = ROW_COUNT();
        COMMIT;
    END IF;
END$$
  INSERT INTO logs_eventos (usuario_id, tabela_nome, registro_id, acao,dados_novos)
    VALUES (@usuario_logado, 'formaçao', p_id, 'UPDATE', v_dados_novos);

DELIMITER ;

DELIMITER $$

CREATE PROCEDURE sp_save_experiencia(
    IN  p_candidato_id INT,
    IN  p_empresa VARCHAR(255),
    IN  p_cargo VARCHAR(255),
    IN  p_descricao TEXT,
    IN  p_data_inicio DATE,
    IN  p_data_fim DATE,
    IN  p_empregador_atual TINYINT,   -- 0 = FALSE, 1 = TRUE, NULL = manter
    IN  p_trabalho_remoto TINYINT,    -- 0 = FALSE, 1 = TRUE, NULL = manter
    IN  p_finalizada TINYINT,         -- 0 = FALSE, 1 = TRUE, NULL = manter
    IN  p_overwrite TINYINT,          -- 0 = parcial (default), 1 = sobrescrever (aceita NULLs)
    OUT p_action VARCHAR(10),         -- 'INSERTED' ou 'UPDATED'
    OUT p_affected_rows INT
)
BEGIN
    DECLARE v_exists_id INT DEFAULT NULL;

    START TRANSACTION;

    -- Validações básicas
    IF p_candidato_id IS NULL OR p_empresa IS NULL OR p_cargo IS NULL OR p_data_inicio IS NULL THEN
        ROLLBACK;
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'candidato_id, empresa, cargo e data_inicio sao obrigatorios';
    END IF;

    -- Validação de datas quando ambas fornecidas
    IF p_data_inicio IS NOT NULL AND p_data_fim IS NOT NULL THEN
        IF p_data_inicio > p_data_fim THEN
            ROLLBACK;
            SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'data_inicio nao pode ser maior que data_fim';
        END IF;
    END IF;

    -- Verifica existência por candidato + empresa + cargo + data_inicio
    SELECT id INTO v_exists_id
    FROM experiencias
    WHERE candidato_id = p_candidato_id
      AND empresa = p_empresa
      AND cargo = p_cargo
      AND data_inicio = p_data_inicio
    LIMIT 1;

    -- Se marcar como empregador atual, desmarca outras experiências atuais do candidato
    IF p_empregador_atual = 1 THEN
        UPDATE experiencias
        SET empregador_atual = 0
        WHERE candidato_id = p_candidato_id
          AND empregador_atual = 1;
    END IF;

    IF v_exists_id IS NOT NULL THEN
        -- Atualização
        IF p_overwrite = 1 THEN
            -- Sobrescreve todos os campos (aceita NULLs)
            UPDATE experiencias
            SET
                descricao = p_descricao,
                data_fim = p_data_fim,
                empregador_atual = p_empregador_atual,
                trabalho_remoto = p_trabalho_remoto,
                finalizada = p_finalizada
            WHERE id = v_exists_id;
        ELSE
            UPDATE experiencias
            SET
                descricao = COALESCE(p_descricao, descricao),
                data_fim = COALESCE(p_data_fim, data_fim),
                empregador_atual = COALESCE(p_empregador_atual, empregador_atual),
                trabalho_remoto = COALESCE(p_trabalho_remoto, trabalho_remoto),
                finalizada = COALESCE(p_finalizada, finalizada)
            WHERE id = v_exists_id;
        END IF;

        SET p_action = 'UPDATED';
        SET p_affected_rows = ROW_COUNT();
        COMMIT;
    ELSE
        -- Insere novo registro
        INSERT INTO experiencias (
            candidato_id,
            empresa,
            cargo,
            descricao,
            data_inicio,
            data_fim,
            empregador_atual,
            trabalho_remoto,
            finalizada
        ) VALUES (
            p_candidato_id,
            p_empresa,
            p_cargo,
            p_descricao,
            p_data_inicio,
            p_data_fim,
            p_empregador_atual,
            p_trabalho_remoto,
            p_finalizada
        );

        SET p_action = 'INSERTED';
        SET p_affected_rows = ROW_COUNT();
        COMMIT;
    END IF;
END$$

CREATE PROCEDURE sp_update_experiencia_by_id(
    IN  p_id BIGINT,
    IN  p_descricao TEXT,
    IN  p_data_fim DATE,
    IN  p_empregador_atual TINYINT,   -- 0 = FALSE, 1 = TRUE, NULL = manter
    IN  p_trabalho_remoto TINYINT,    -- 0 = FALSE, 1 = TRUE, NULL = manter
    IN  p_finalizada TINYINT,         -- 0 = FALSE, 1 = TRUE, NULL = manter
    IN  p_overwrite TINYINT,          -- 0 = parcial, 1 = sobrescrever (aceita NULLs)
    IN  p_changed_by VARCHAR(100),    -- usuário que fez a alteração (opcional)
    OUT p_affected_rows INT
)
BEGIN
    DECLARE v_exists INT DEFAULT 0;
    DECLARE v_candidato_id INT;
    DECLARE v_empresa VARCHAR(255);
    DECLARE v_cargo VARCHAR(255);
    DECLARE v_descricao_old TEXT;
    DECLARE v_data_inicio_old DATE;
    DECLARE v_data_fim_old DATE;
    DECLARE v_empregador_atual_old TINYINT;
    DECLARE v_trabalho_remoto_old TINYINT;
    DECLARE v_finalizada_old TINYINT;
    DECLARE v_old_json TEXT;
    DECLARE v_new_json TEXT;

    START TRANSACTION;

    -- Verifica existência do registro
    SELECT COUNT(*) INTO v_exists FROM experiencias WHERE id = p_id;
    IF v_exists = 0 THEN
        ROLLBACK;
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Experiencia nao encontrada para o id informado';
    END IF;

    -- Busca valores antigos
    SELECT candidato_id,
           empresa,
           cargo,
           descricao,
           data_inicio,
           data_fim,
           empregador_atual,
           trabalho_remoto,
           finalizada
    INTO v_candidato_id,
         v_empresa,
         v_cargo,
         v_descricao_old,
         v_data_inicio_old,
         v_data_fim_old,
         v_empregador_atual_old,
         v_trabalho_remoto_old,
         v_finalizada_old
    FROM experiencias
    WHERE id = p_id
    LIMIT 1;

    -- Validação de datas quando ambas fornecidas
    IF p_data_fim IS NOT NULL AND v_data_inicio_old IS NOT NULL THEN
        IF v_data_inicio_old > p_data_fim THEN
            ROLLBACK;
            SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'data_inicio nao pode ser maior que data_fim';
        END IF;
    END IF;

    -- Se marcar como empregador atual, desmarca outras experiencias atuais do candidato
    IF p_empregador_atual = 1 THEN
        UPDATE experiencias
        SET empregador_atual = 0
        WHERE candidato_id = v_candidato_id
          AND empregador_atual = 1
          AND id <> p_id;
    END IF;

    -- Monta JSON com valores antigos
    SET v_old_json = JSON_OBJECT(
        'id', p_id,
        'candidato_id', v_candidato_id,
        'empresa', v_empresa,
        'cargo', v_cargo,
        'descricao', v_descricao_old,
        'data_inicio', IF(v_data_inicio_old IS NULL, NULL, DATE_FORMAT(v_data_inicio_old, '%Y-%m-%d')),
        'data_fim', IF(v_data_fim_old IS NULL, NULL, DATE_FORMAT(v_data_fim_old, '%Y-%m-%d')),
        'empregador_atual', v_empregador_atual_old,
        'trabalho_remoto', v_trabalho_remoto_old,
        'finalizada', v_finalizada_old
    );

    -- Atualização (parcial ou overwrite)
    IF p_overwrite = 1 THEN
        UPDATE experiencias
        SET
            descricao = p_descricao,
            data_fim = p_data_fim,
            empregador_atual = p_empregador_atual,
            trabalho_remoto = p_trabalho_remoto,
            finalizada = p_finalizada
        WHERE id = p_id;
    ELSE
        UPDATE experiencias
        SET
            descricao = COALESCE(p_descricao, descricao),
            data_fim = COALESCE(p_data_fim, data_fim),
            empregador_atual = COALESCE(p_empregador_atual, empregador_atual),
            trabalho_remoto = COALESCE(p_trabalho_remoto, trabalho_remoto),
            finalizada = COALESCE(p_finalizada, finalizada)
        WHERE id = p_id;
    END IF;

    SET p_affected_rows = ROW_COUNT();

    -- Busca valores novos
    SELECT
        id,
        candidato_id,
        empresa,
        cargo,
        descricao,
        data_inicio,
        data_fim,
        empregador_atual,
        trabalho_remoto,
        finalizada
    INTO
        @new_id,
        @new_candidato_id,
        @new_empresa,
        @new_cargo,
        @new_descricao,
        @new_data_inicio,
        @new_data_fim,
        @new_empregador_atual,
        @new_trabalho_remoto,
        @new_finalizada
    FROM experiencias
    WHERE id = p_id
    LIMIT 1;

    SET v_new_json = JSON_OBJECT(
        'id', @new_id,
        'candidato_id', @new_candidato_id,
        'empresa', @new_empresa,
        'cargo', @new_cargo,
        'descricao', @new_descricao,
        'data_inicio', IF(@new_data_inicio IS NULL, NULL, DATE_FORMAT(@new_data_inicio, '%Y-%m-%d')),
        'data_fim', IF(@new_data_fim IS NULL, NULL, DATE_FORMAT(@new_data_fim, '%Y-%m-%d')),
        'empregador_atual', @new_empregador_atual,
        'trabalho_remoto', @new_trabalho_remoto,
        'finalizada', @new_finalizada
    );

    INSERT INTO experiencias_auditoria (
        experiencia_id,
        candidato_id,
        action,
        old_values,
        new_values,
        changed_by
    ) VALUES (
        p_id,
        v_candidato_id,
        'UPDATE',
        v_old_json,
        v_new_json,
        p_changed_by
    );

    SELECT JSON_PRETTY(v_old_json) AS old_values;
    SELECT JSON_PRETTY(v_new_json) AS new_values;

    COMMIT;
END$$

DELIMITER ;

DELIMITER $$

CREATE PROCEDURE sp_save_candidatura(
    IN  p_id INT,                    
    IN  p_candidato_id INT,
    IN  p_vaga_id INT,
    IN  p_data_candidatura DATETIME,
    IN  p_data_atualizacao DATETIME,
    IN  p_status_id INT,
    IN  p_overwrite TINYINT,       
    OUT p_action VARCHAR(10),        -- 'INSERTED' ou 'UPDATED'
    OUT p_affected_rows INT
)
BEGIN
    DECLARE v_exists_id INT DEFAULT NULL;
    DECLARE v_count INT DEFAULT 0;

    START TRANSACTION;

    -- Validações básicas
    IF p_candidato_id IS NULL OR p_vaga_id IS NULL THEN
        ROLLBACK;
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'candidato_id e vaga_id sao obrigatorios';
    END IF;

    -- Normaliza datas: se NULL, usa NOW() para data_atualizacao quando for insert
    IF p_data_atualizacao IS NULL THEN
        SET p_data_atualizacao = NOW();
    END IF;

    -- Verifica existência por candidato + vaga
    SELECT id INTO v_exists_id
    FROM candidaturas
    WHERE candidato_id = p_candidato_id
      AND vaga_id = p_vaga_id
    LIMIT 1;

    IF v_exists_id IS NOT NULL THEN
        -- Atualização
        IF p_overwrite = 1 THEN
            UPDATE candidaturas
            SET
                data_candidatura = p_data_candidatura,
                data_atualizacao = p_data_atualizacao,
                status_id = p_status_id
            WHERE id = v_exists_id;
        ELSE
            UPDATE candidaturas
            SET
                data_candidatura = COALESCE(p_data_candidatura, data_candidatura),
                data_atualizacao = COALESCE(p_data_atualizacao, data_atualizacao),
                status_id = COALESCE(p_status_id, status_id)
            WHERE id = v_exists_id;
        END IF;

        SET p_action = 'UPDATED';
        SET p_affected_rows = ROW_COUNT();
        COMMIT;
    ELSE
        IF p_id IS NOT NULL THEN
            SELECT COUNT(*) INTO v_count FROM candidaturas WHERE id = p_id;
            IF v_count > 0 THEN
                ROLLBACK;
                SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'ID informado ja existe';
            END IF;
        END IF;

        IF p_id IS NULL THEN
            INSERT INTO candidaturas (candidato_id, vaga_id, data_candidatura, data_atualizacao, status_id)
            VALUES (p_candidato_id, p_vaga_id, p_data_candidatura, p_data_atualizacao, p_status_id);
            SET p_action = 'INSERTED';
            SET p_affected_rows = ROW_COUNT();
        ELSE
            INSERT INTO candidaturas (id, candidato_id, vaga_id, data_candidatura, data_atualizacao, status_id)
            VALUES (p_id, p_candidato_id, p_vaga_id, p_data_candidatura, p_data_atualizacao, p_status_id);
            SET p_action = 'INSERTED';
            SET p_affected_rows = ROW_COUNT();
        END IF;

        COMMIT;
    END IF;
END$$

DELIMITER ;

CREATE TABLE IF NOT EXISTS candidaturas_auditoria (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  candidatura_id BIGINT NOT NULL,
  candidato_id INT NOT NULL,
  vaga_id INT NOT NULL,
  action VARCHAR(10) NOT NULL,      -- 'UPDATE'
  old_values JSON NULL,
  new_values JSON NOT NULL,
  changed_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  changed_by VARCHAR(100) NULL
);

DELIMITER $$

CREATE PROCEDURE sp_update_candidatura_by_id(
    IN  p_id BIGINT,
    IN  p_data_candidatura DATETIME,
    IN  p_data_atualizacao DATETIME,
    IN  p_status_id INT,
    IN  p_overwrite TINYINT,          -- 0 = parcial, 1 = sobrescrever
    IN  p_changed_by VARCHAR(100),  
    OUT p_affected_rows INT
)
BEGIN
    DECLARE v_exists INT DEFAULT 0;
    DECLARE v_candidato_id INT;
    DECLARE v_vaga_id INT;
    DECLARE v_data_candidatura_old DATETIME;
    DECLARE v_data_atualizacao_old DATETIME;
    DECLARE v_status_id_old INT;
    DECLARE v_old_json JSON;
    DECLARE v_new_json JSON;

    START TRANSACTION;

    -- Verifica existência
    SELECT COUNT(*) INTO v_exists FROM candidaturas WHERE id = p_id;
    IF v_exists = 0 THEN
        ROLLBACK;
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Candidatura nao encontrada para o id informado';
    END IF;

    -- Busca valores antigos
    SELECT candidato_id, vaga_id, data_candidatura, data_atualizacao, status_id
    INTO v_candidato_id, v_vaga_id, v_data_candidatura_old, v_data_atualizacao_old, v_status_id_old
    FROM candidaturas
    WHERE id = p_id
    LIMIT 1;

    -- Validação de datas quando aplicável
    IF p_data_candidatura IS NOT NULL AND p_data_atualizacao IS NOT NULL THEN
        IF p_data_candidatura > p_data_atualizacao THEN
            ROLLBACK;
            SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'data_candidatura nao pode ser maior que data_atualizacao';
        END IF;
    END IF;

    SET v_old_json = JSON_OBJECT(
        'id', p_id,
        'candidato_id', v_candidato_id,
        'vaga_id', v_vaga_id,
        'data_candidatura', IF(v_data_candidatura_old IS NULL, NULL, DATE_FORMAT(v_data_candidatura_old, '%Y-%m-%d %H:%i:%s')),
        'data_atualizacao', IF(v_data_atualizacao_old IS NULL, NULL, DATE_FORMAT(v_data_atualizacao_old, '%Y-%m-%d %H:%i:%s')),
        'status_id', v_status_id_old
    );

    IF p_overwrite = 1 THEN
        UPDATE candidaturas
        SET
            data_candidatura = p_data_candidatura,
            data_atualizacao = p_data_atualizacao,
            status_id = p_status_id
        WHERE id = p_id;
    ELSE
        UPDATE candidaturas
        SET
            data_candidatura = COALESCE(p_data_candidatura, data_candidatura),
            data_atualizacao = COALESCE(p_data_atualizacao, data_atualizacao),
            status_id = COALESCE(p_status_id, status_id)
        WHERE id = p_id;
    END IF;

    SET p_affected_rows = ROW_COUNT();

    -- Busca valores novos
    SELECT id, candidato_id, vaga_id, data_candidatura, data_atualizacao, status_id
    INTO @new_id, @new_candidato_id, @new_vaga_id, @new_data_candidatura, @new_data_atualizacao, @new_status_id
    FROM candidaturas
    WHERE id = p_id
    LIMIT 1;

    SET v_new_json = JSON_OBJECT(
        'id', @new_id,
        'candidato_id', @new_candidato_id,
        'vaga_id', @new_vaga_id,
        'data_candidatura', IF(@new_data_candidatura IS NULL, NULL, DATE_FORMAT(@new_data_candidatura, '%Y-%m-%d %H:%i:%s')),
        'data_atualizacao', IF(@new_data_atualizacao IS NULL, NULL, DATE_FORMAT(@new_data_atualizacao, '%Y-%m-%d %H:%i:%s')),
        'status_id', @new_status_id
    );

    INSERT INTO candidaturas_auditoria (
        candidatura_id,
        candidato_id,
        vaga_id,
        action,
        old_values,
        new_values,
        changed_by
    ) VALUES (
        p_id,
        v_candidato_id,
        v_vaga_id,
        'UPDATE',
        v_old_json,
        v_new_json,
        p_changed_by
    );

    SELECT JSON_PRETTY(v_old_json) AS old_values;
    SELECT JSON_PRETTY(v_new_json) AS new_values;

    COMMIT;
END$$

DELIMITER ;



